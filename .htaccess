# Howbridge Infant School
#
# GENERATED by scripts/build-redirects.mjs. Do not edit by hand: change the
# page map in scripts/import-content.mjs and run `npm run redirects`.
#
# Every rule here is an address a parent may have bookmarked or Google has
# indexed. A 301 tells search engines the move is permanent, so the old
# page's standing transfers to the new one.

# The website is served straight out of a git clone, so .git sits inside the
# document root. Without this, anyone who guesses the address can walk the
# whole repository: every file, every past version, every commit message.
# Deny the directory and the loose metadata files beside it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>
<FilesMatch "^\.(git|gitignore|gitattributes|gitmodules)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host and scheme. Everything arrives on https and without www,
  # so a page is never reachable at four addresses that all look different
  # to a search engine.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

<IfModule mod_alias.c>

  # The orphaned policy tree: the pages at /policy/, unlinked from the
  # site for years, still indexed, and sixteen of them serving a document the
  # school has since replaced. The whole tree goes to the new policy index.
  RedirectMatch 301 ^/policy/?.*$ /key-information/policies/

  # The old Divi Machine policy records.
  RedirectMatch 301 ^/school_policies/?.*$ /key-information/policies/

  # WordPress feeds, author pages and the login screen. None of them exist
  # any more, and the login screen in particular should not look alive.
  RedirectMatch 301 ^/(wp-login\.php|wp-admin|author|feed)/?.*$ /

  # Ethos and values
  Redirect 301 /about-us/ethos-and-core-values /about-us/ethos-and-values/
  # Ofsted and results
  Redirect 301 /about-us/ofsted-report /about-us/ofsted-and-results/
  # Our results
  Redirect 301 /about-us/school-results /about-us/ofsted-and-results/results/
  # Classes
  Redirect 301 /classes /curriculum/classes/
  # Early years
  Redirect 301 /classes/eyfs /curriculum/early-years/
  # Phonics and reading
  Redirect 301 /curriculum/reading-and-phonics /curriculum/phonics-and-reading/
  # Year One
  Redirect 301 /classes/year-one /curriculum/year-one/
  # Year Two
  Redirect 301 /classes/year-two /curriculum/year-two/
  # Admissions
  Redirect 301 /about-us/admissions /key-information/admissions/
  # Admission appeals
  Redirect 301 /about-us/appeals /key-information/admissions/appeals/
  # Complaints
  Redirect 301 /parents-and-carers/complaints /key-information/complaints/
  # Data Protection
  Redirect 301 /parents-and-carers/data-protection /key-information/data-protection/
  # Equality
  Redirect 301 /about-us/equality /key-information/equality/
  # Finance
  Redirect 301 /finance /key-information/finance/
  # Pupil Premium
  Redirect 301 /about-us/pupil-premium /key-information/pupil-premium/
  # SEND
  Redirect 301 /about-us/send /key-information/send/
  # PE and sport premium
  Redirect 301 /about-us/sport-premium /key-information/sport-premium/
  # Community
  Redirect 301 /community-page /news-and-events/community/
  # News and letters
  Redirect 301 /letters-home /news-and-events/news/
  # Attendance and absence
  Redirect 301 /attendance-leave-of-absence /parents-and-carers/absence/
  # Online safety
  Redirect 301 /parents-and-carers/e-safety /parents-and-carers/online-safety/
  # The school day
  Redirect 301 /school-opening-times /parents-and-carers/school-day/
  # Term and INSET dates
  Redirect 301 /http-howbridge-inf-essex-sch-uk-wp-content-uploads-2025-07-parents-diary-dates-booklet-2025-2026-email-version-pdf /parents-and-carers/term-dates/
  # Uniform
  Redirect 301 /school-uniform /parents-and-carers/uniform/
  # Mental health and wellbeing
  Redirect 301 /mental-health-and-wellbeing /parents-and-carers/wellbeing/
  # Policies
  Redirect 301 /about-us/policies /key-information/policies/
  # Events
  Redirect 301 /events /news-and-events/events/
  # WordPress default page
  Redirect 301 /sample-page /
  # Test page
  Redirect 301 /newsletter-test /news-and-events/newsletters/
  # Duplicate newsletter page
  Redirect 301 /news-and-events/newsletter /news-and-events/newsletters/
  # Noticeboard
  Redirect 301 /news-and-events/noticeboard /news-and-events/
  # Community archive
  Redirect 301 /community-page-archive /news-and-events/community/
  # Community links
  Redirect 301 /parents-and-carers/community-link /news-and-events/community/
  # Extended schools
  Redirect 301 /parents-and-carers/extended-schools /parents-and-carers/clubs/
  # Videos
  Redirect 301 /parents-and-carers/videos /parents-and-carers/
  # Home learning
  Redirect 301 /home-learning /curriculum/
  # Upload form
  Redirect 301 /add-reception-newsletter /news-and-events/newsletters/
  # Upload form
  Redirect 301 /add-year-1-or-2-newsletter /news-and-events/newsletters/
  # Upload form
  Redirect 301 /add-newsletter-page /news-and-events/newsletters/
  # Upload form
  Redirect 301 /whole-school-news /news-and-events/news/

</IfModule>

# A page that does not exist should say so in the site's own voice.
ErrorDocument 404 /404.html
